# Server-only configuration. Copy to .env.local for a new setup.
# Never commit .env.local or use NEXT_PUBLIC_ for these values.

# Required: OpenRouter serves both embeddings and answer generation.
OPENROUTER_API_KEY=

# Required: Qdrant Cloud cluster HTTPS URL and write-capable ingestion key.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_documents

# Optional defaults. Keep ingestion and retrieval in the same vector space.
# See docs/configuration.md before changing the embedding model or dimensions.
# RAG_EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
# RAG_EMBEDDING_DIMENSIONS=1024
# RAG_EMBEDDING_BATCH_SIZE=16
# RAG_EMBEDDING_TIMEOUT_MS=30000
# RAG_EMBEDDING_MAX_RETRIES=3
# RAG_CHUNK_SIZE=1000
# RAG_CHUNK_OVERLAP=200

# Retrieval and prompt settings. Leave MIN_SCORE unset for no threshold.
# RAG_SEARCH_LIMIT=10
# RAG_SEARCH_MIN_SCORE=0.5
# RAG_CONTEXT_TOKEN_BUDGET=8192

# Answer model through the fixed OpenRouter endpoint.
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# LLM_TIMEOUT_MS=180000

# Optional Cohere reranking. A key is needed only when enabled.
# RAG_RERANK_ENABLED=false
# COHERE_API_KEY=
# RAG_RERANK_MODEL=rerank-v5.0-fast
# RAG_RERANK_TOP_N=5
# RAG_RERANK_TIMEOUT_MS=10000
